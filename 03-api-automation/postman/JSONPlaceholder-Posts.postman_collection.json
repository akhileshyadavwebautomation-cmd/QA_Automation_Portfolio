{
  "info": {
    "_postman_id": "5a0b9d7a-7a35-4f6c-9c31-qa-portfolio",
    "name": "QA Portfolio - JSONPlaceholder Posts API",
    "description": "GET, filter, POST, PUT and DELETE examples. JSONPlaceholder simulates writes; data is not persisted.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get post by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        }
      }
    },
    {
      "name": "Filter posts by user",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/posts?userId=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ],
          "query": [
            {
              "key": "userId",
              "value": "1"
            }
          ]
        }
      }
    },
    {
      "name": "Create post (simulated)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Portfolio API test\",\"body\":\"Created from Postman\",\"userId\":7}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        }
      }
    },
    {
      "name": "Update post (simulated)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"id\":1,\"title\":\"Updated title\",\"body\":\"Updated body\",\"userId\":1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        }
      }
    },
    {
      "name": "Delete post (simulated)",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        }
      }
    }
  ]
}